@model IEnumerable<OrderDetails>
@using Web.Models // dùng nếu OrderStatus là enum riêng ngoài OrderDetails

@{
    ViewData["Title"] = "Order Details";
}

<h3>Order Details</h3>
<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Order Code</th>
            <th scope="col">Customer Name</th>
            <th scope="col">Product ID</th>
            <th scope="col">Product Name</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
            <th scope="col">Total</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.OrderCode</td>
                <td>@item.CustomerName</td>
                <td>@item.ProductID</td>
                <td>@item.Product?.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@(item.Price * item.Quantity).ToString("C")</td>
                <td>
                    @if (item.Order != null &&  item.Order.Status == OrderStatus.Pending)
                    {
                        <button class="btn btn-sm btn-success confirm-order-btn" data-order-code="@item.OrderCode">
                            Xác nhận
                        </button>
                    }
                    else
                    {
                        <span class="text-success">Đã xác nhận</span>
                    }
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="7" class="text-end"><strong>Total Order Amount:</strong></td>
            <td colspan="2">@Model.Sum(item => item.Price * item.Quantity).ToString("C")</td>
        </tr>
    </tfoot>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.confirm-order-btn').click(function () {
                var button = $(this);
                var orderCode = button.data('order-code');

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("UpdateOrder")',
                    data: { orderCode: orderCode, status: 0 }, // 0 = Successfully
                    success: function (response) {
                        alert('Đơn hàng đã được xác nhận!');
                        // Tuỳ bạn có thể reload hoặc cập nhật giao diện
                        location.reload();
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi xác nhận đơn hàng.');
                    }
                });
            });
        });
    </script>
}
