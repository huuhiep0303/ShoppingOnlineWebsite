@model IEnumerable<OrderDetails>
@{
    ViewData["Title"] = "Order Details";
}
<h3>Order Details</h3>
<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Order Code</th>
            <th scope="col">Customer Name</th>
            <th scope="col">Product ID</th>
            <th scope="col">Product Name</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
            <th scope="col">Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <input type="hidden" asp-for="@item.OrderCode" class="getId" />
                <th scope="row">@item.Id</th>
                <td>@item.OrderCode</td>
                <td>@item.CustomerName</td>
                <td>@item.ProductID</td>
                <td>@item.Product?.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@((item.Price * item.Quantity).ToString("C"))</td>
            </tr>
        }
    </tbody>

    <tfoot>
        <tr>
            <td colspan="7" class="text-end"><strong>Total Order Amount:</strong></td>
            <td>
                @Model.Sum(item => item.Price * item.Quantity).ToString("C")
            </td>
            <td>
                <select class="form-control select-update-order">
                    <option value="1">Pending order</option>
                    <option value="0">Successfully order</option>
                </select>
            </td>
        </tr>
    </tfoot>

</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select-update-order').change(function () {
                var status = $(this).val();
                var orderCode = $('.getId').val();

                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("UpdateOrder")',
                    data: { orderCode: orderCode, status: status },
                    success: function (response) {
                        alert('Order status updated successfully!');
                    },
                    error: function (xhr, status, error) {
                        alert('Error updating order status.');
                    }
                });
            });
        });
    </script>
}