@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<section id="">
	<!--form-->
	<div class="container"> 
		<div class="row"> 
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Login to your account</h2>
					<form asp-action="Login" asp-controller="Account">
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>

						<div class="form-group">
							<label>Username</label>
							<input asp-for="Username" class="form-control" />
							<span asp-validation-for="Username" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label>Password</label>
							<input asp-for="Password" class="form-control" />
							<span asp-validation-for="Password" class="text-danger"></span>
						</div>

						<button class="btn btn-default">Login</button>
						<a asp-action="Register" asp-controller="Account" class="btn btn-warning">Register User</a><br />
						<a asp-action="ForgetPass" asp-controller="Account" class="btn btn-warning">Forget Password</a>
					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}