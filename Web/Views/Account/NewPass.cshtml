@model AppUserModel
@{
	ViewData["Title"] = "Reset Password";
}
<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Reset Password</h2>
					<form asp-action="UpdateNewPassword" asp-controller="Account">
						<div asp-validation-summary="ModelOnly" class="text-danger"></div>
						<input type="hidden" name="token" value="@ViewBag.Token"/>
						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" readonly value="@ViewBag.Email" class="form-control" />
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label>New Password</label>
							<input asp-for="PasswordHash" class="form-control" />
							<span asp-validation-for="PasswordHash" class="text-danger"></span>
						</div>

						<button class="btn btn-default">Apply</button>
						<a asp-action="Register" asp-controller="Account">Register User</a><br />
					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}