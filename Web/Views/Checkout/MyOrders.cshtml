@model IEnumerable<Web.Models.OrderModel>
@{
    ViewBag.Title = "Đơn hàng của tôi";
}
<h2>Đơn hàng của tôi</h2>
<table class="table">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th>Chi tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var order in Model)
        {
            <tr>
                <td>@order.OrderCode</td>
                <td>@order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @{
                        string status = order.Status switch {
                            1 => "Đang xử lý",
                            2 => "Đang giao",
                            3 => "Đã giao",
                            4 => "Đã hủy",
                            _ => "Không xác định"
                        };
                    }
                    @status
                </td>
                <td>
                    <a asp-action="OrderDetails" asp-route-id="@order.Id">Xem chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>