@model IEnumerable<Web.Models.OrderDetails>
@{
    var order = (Web.Models.OrderModel)ViewBag.Order;
    ViewBag.Title = "Chi tiết đơn hàng";
}
<h2>Chi tiết đơn hàng: @order.OrderCode</h2>
<p>Ngày đặt: @order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
<p>Trạng thái: 
    @{
        string status = order.Status switch {
            1 => "Đang xử lý",
            2 => "Đang giao",
            3 => "Đã giao",
            4 => "Đã hủy",
            _ => "Không xác định"
        };
    }
    @status
</p>
<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Giá</th>
            <th>Số lượng</th>
            <th>Tổng</th>
            <th>Đánh giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Price.ToString("N0")</td>
                <td>@item.Quantity</td>
                <td>@(item.Price * item.Quantity).ToString("N0")</td>
                <td>
                    @if(order.Status == 3) { // Đã giao mới cho đánh giá
                        <a asp-action="Review" asp-controller="Review" asp-route-productId="@item.ProductID" asp-route-orderId="@order.Id">Đánh giá</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>